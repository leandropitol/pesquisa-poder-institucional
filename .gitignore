# brutos e derivados ficam fora do Git (manifestos com sha256 ficam dentro)
data/raw/*
!data/raw/README.md
data/staging/*
!data/staging/.gitkeep
data/derivados/*
!data/derivados/.gitkeep
__pycache__/
.pytest_cache/
.venv/
.env
*.env
# capturas feitas no navegador (D-015) não podem ser refeitas por script: ficam versionadas
!data/raw/tse_partidos/
