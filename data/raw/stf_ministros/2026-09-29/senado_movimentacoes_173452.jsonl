{"url": "https://legis.senado.leg.br/dadosabertos/materia/movimentacoes/173452.json", "params": {"codigo_materia": "173452"}, "status": 200, "obtido_em": "2026-09-29T14:55:45", "corpo": {"MovimentacaoMateria": {"noNamespaceSchemaLocation": "https://legis.senado.leg.br/dadosabertos/dados/MovimentacaoMateriav7.xsd", "Metadados": {"Versao": "29/09/2026 14:54:22", "VersaoServico": "7", "DataVersaoServico": "2020-07-08", "DescricaoDataSet": "Informes Legislativos, Movimentações, Despachos, Prazos, Ordens do Dia em que constou etc.", "Descontinuacao": {"DataDepreciacao": "2025-03-18", "DataDesativacaoCompleta": "2026-02-01", "UrlServicoSubstituto": "https://legis.senado.leg.br/dadosabertos/processo/{idProcesso}"}}, "Materia": {"IdentificacaoMateria": {"CodigoMateria": "173452", "SiglaCasaIdentificacaoMateria": "SF", "NomeCasaIdentificacaoMateria": "Senado Federal", "SiglaSubtipoMateria": "MSF", "DescricaoSubtipoMateria": "Mensagem (SF)", "NumeroMateria": "7", "AnoMateria": "2026", "DescricaoIdentificacaoMateria": "MSF 7/2026", "IndicadorTramitando": "Não", "IdentificacaoProcesso": "9026396"}, "IdentificacaoExterna": {"Sigla": "MSG", "Numero": "1714", "Ano": "2025", "SiglaOrigemExterna": "PR", "NomeOrigemExterna": "Presidência da República"}, "Autuacoes": {"Autuacao": [{"NumeroAutuacao": "1", "DescricaoAutuacao": "Autuação Principal", "SituacoesAtuais": {"SituacaoAtual": [{"DataSituacao": "2026-04-29", "CodigoSituacao": "49", "SiglaSituacao": "RJTDA", "DescricaoSituacao": "REJEITADA"}]}, "InformesLegislativos": {"InformeLegislativo": [{"Data": "2026-05-04 22:22:46", "IdInformeLegislativo": "2284262", "Descricao": "Remetido Ofício SF nº 336, de 2026, à Ministra de Estado Chefe da Casa Civil da Presidência da República, encaminhando a Mensagem SF nº 86, de 2026, ao Excelentíssimo Senhor Presidente da República, Com referência à Mensagem nº 7, de 2026 (nº 1.714, de 2025, nessa Presidência), participo a Vossa Excelência que o Senado Federal rejeitou, em sessão realizada no dia 29 de abril de 2026, a escolha do Senhor Jorge Rodrigo Araújo Messias, para exercer o cargo de Ministro do Supremo Tribunal Federal, em vaga decorrente da aposentadoria do Ministro Luís Roberto Barroso.  Recebido no destino em 04/05/2026 às 22:22:46.\n\nRemetido Mensagem SF nº 87, de 2026, ao Presidente do Supremo Tribunal Federal, participando a Vossa Excelência que o Senado Federal rejeitou o nome do Senhor Jorge Rodrigo Araújo Messias, para exercer o cargo de Ministro do Supremo Tribunal Federal, em vaga decorrente da aposentadoria do Ministro Luís Roberto Barroso, em sessão realizada em 29 de abril de 2026.", "Local": {"CodigoLocal": "55304", "SiglaLocal": "SEXPE", "NomeLocal": "Secretaria de Expediente", "SiglaCasaLocal": "SF", "NomeCasaLocal": "Senado Federal"}, "TextosAssociados": {"TextoAssociado": [{"CodigoTexto": "10212248", "DescricaoTipoTexto": "Ofício", "TipoDocumento": "PDF", "FormatoTexto": "application/pdf", "DataTexto": "2026-04-29", "UrlTexto": "http://legis.senado.leg.br/sdleg-getter/documento?dm=10212248", "DescricaoTexto": "OFSF 336/2026", "AutoriaTexto": "Primeiro-Secretário do Senado Federal"}, {"CodigoTexto": "10212251", "DescricaoTipoTexto": "Mensagem", "TipoDocumento": "PDF", "FormatoTexto": "application/pdf", "DataTexto": "2026-04-29", "UrlTexto": "http://legis.senado.leg.br/sdleg-getter/documento?dm=10212251", "DescricaoTexto": "MPSF 87/2026", "AutoriaTexto": "Presidente do Senado Federal"}, {"CodigoTexto": "10212274", "DescricaoTipoTexto": "Mensagem", "TipoDocumento": "PDF", "FormatoTexto": "application/pdf", "DataTexto": "2026-04-29", "UrlTexto": "http://legis.senado.leg.br/sdleg-getter/documento?dm=10212274", "DescricaoTexto": "MPSF 86/2026", "AutoriaTexto": "Presidente do Senado Federal"}]}}, {"Data": "2026-04-29 19:41:03", "IdInformeLegislativo": "2283891", "Descricao": "(Sessão Deliberativa Ordinária de 29 de abril de 2026) \nEncerrada a votação, com o seguinte resultado: Sim - 34, Não - 42 , Abstenções -1 , Total -77. \nRejeitada a indicação. A matéria vai ao Arquivo. \nSerá feita a devida comunicação à Presidência da República.", "Local": {"CodigoLocal": "13594", "SiglaLocal": "SEADI", "NomeLocal": "Secretaria de Atas e Diários", "SiglaCasaLocal": "SF", "NomeCasaLocal": "Senado Federal"}, "Colegiado": {"CodigoColegiado": "1998", "SiglaColegiado": "PLEN", "NomeColegiado": "Plenário do Senado Federal", "SiglaCasaColegiado": "SF", "NomeCasaColegiado": "Senado Federal"}, "SituacaoIniciada": {"CodigoSituacao": "49", "SiglaSituacao": "RJTDA"}}, {"Data": "2026-04-29 18:22:48", "IdInformeLegislativo": "2283861", "Descricao": "Encerrada a relatoria do Senador Weverton por deliberação da matéria.\nÀ SLSF, para prosseguimento da tramitação.", "Local": {"CodigoLocal": "13565", "SiglaLocal": "SACCJ", "NomeLocal": "Secretaria de Apoio à Comissão de Constituição, Justiça e Cidadania", "SiglaCasaLocal": "SF", "NomeCasaLocal": "Senado Federal"}, "Colegiado": {"CodigoColegiado": "34", "SiglaColegiado": "CCJ", "NomeColegiado": "Comissão de Constituição, Justiça e Cidadania", "SiglaCasaColegiado": "SF", "NomeCasaColegiado": "Senado Federal"}}, {"Data": "2026-04-29 17:59:55", "IdInformeLegislativo": "2283877", "Descricao": "Na 6ª Reunião Extraordinária, realizada nesta data, a Comissão aprova o Parecer da CCJ, após arguição pública, em escrutínio secreto, que conclui pela escolha do nome do Senhor JORGE RODRIGO ARAÚJO MESSIAS para exercer o cargo de Ministro do Supremo Tribunal Federal, nos termos do art. 52, inciso III, alínea “a”, e do art. 101, parágrafo único, da Constituição Federal, com 16 (dezesseis) votos favoráveis e 11(onze) votos contrários.\n\nA Comissão aprova o Requerimento nº 12, de 2026-CCJ, de autoria do Senador Eduardo Braga, de URGÊNCIA para a matéria.\n\nUsam da palavra os Senadores, Magno Malta, Jaques Wagner, Camilo Santana, Eliziane Gama, Fabiano Contarato, Weverton, Vanderlan Cardoso, Flávio Bolsonaro, Márcio Bittar, Sergio Moro, Rogério Carvalho, Jayme Campos, Eduardo Girão, Rogério Marinho, Esperidião Amin, Teresa Leitão, Renan Filho, Jaime Bagattoli, Dr. Hiran, Hamilton Mourão, Izalci Lucas, Carlos Portinho, Marcos Rogério, Soraya Thronicke, Dr. Hiran, Jorge Seif, Roberta Acioly, Marcos Rogério, Alessandro Vieira, Eduardo Braga, Randolfe Rodrigues, Cleitinho e o Senador Otto Alencar, Presidente da CCJ.\n\nÉ consignado o voto do Senador Otto Alencar, Presidente da CCJ.\n\nAnexei o Relatório do Senador Weverton.", "Local": {"CodigoLocal": "13565", "SiglaLocal": "SACCJ", "NomeLocal": "Secretaria de Apoio à Comissão de Constituição, Justiça e Cidadania", "SiglaCasaLocal": "SF", "NomeCasaLocal": "Senado Federal"}, "Colegiado": {"CodigoColegiado": "34", "SiglaColegiado": "CCJ", "NomeColegiado": "Comissão de Constituição, Justiça e Cidadania", "SiglaCasaColegiado": "SF", "NomeCasaColegiado": "Senado Federal"}, "SituacaoIniciada": {"CodigoSituacao": "89", "SiglaSituacao": "APRVPAR"}, "TextosAssociados": {"TextoAssociado": [{"CodigoTexto": "10212543", "DescricaoTipoTexto": "Parecer", "TipoDocumento": "PDF", "FormatoTexto": "application/pdf", "DataTexto": "2026-04-29", "UrlTexto": "http://legis.senado.leg.br/sdleg-getter/documento?dm=10212543", "DescricaoTexto": "P.S 30/2026 - CCJ", "AutoriaTexto": "Comissão de Constituição, Justiça e Cidadania"}, {"CodigoTexto": "10212523", "DescricaoTipoTexto": "Requerimento", "TipoDocumento": "PDF", "FormatoTexto": "application/pdf", "DataTexto": "2026-04-29", "UrlTexto": "http://legis.senado.leg.br/sdleg-getter/documento?dm=10212523", "DescricaoTexto": "REQ 12/2026 - CCJ", "AutoriaTexto": "Comissão de Constituição, Justiça e Cidadania"}]}}, {"Data": "2026-04-15 10:25:58", "IdInformeLegislativo": "2282534", "Descricao": "Na 5ª Reunião Extraordinária, realizada nesta data, o Senador Weverton lê o Relatório e a matéria é submetida à primeira etapa do processo de apreciação de escolha de autoridades nesta Comissão, conforme disposto no art. 383 do Regimento Interno do Senado Federal.\n\nA Presidência concede vista coletiva, nos termos regimentais.", "Local": {"CodigoLocal": "13565", "SiglaLocal": "SACCJ", "NomeLocal": "Secretaria de Apoio à Comissão de Constituição, Justiça e Cidadania", "SiglaCasaLocal": "SF", "NomeCasaLocal": "Senado Federal"}, "Colegiado": {"CodigoColegiado": "34", "SiglaColegiado": "CCJ", "NomeColegiado": "Comissão de Constituição, Justiça e Cidadania", "SiglaCasaColegiado": "SF", "NomeCasaColegiado": "Senado Federal"}, "SituacaoIniciada": {"CodigoSituacao": "90", "SiglaSituacao": "PEDVISTA"}}, {"Data": "2026-04-14 21:15:11", "IdInformeLegislativo": "2282482", "Descricao": "Recebido, nesta Comissão, o relatório do Senador Weverton.", "Local": {"CodigoLocal": "13565", "SiglaLocal": "SACCJ", "NomeLocal": "Secretaria de Apoio à Comissão de Constituição, Justiça e Cidadania", "SiglaCasaLocal": "SF", "NomeCasaLocal": "Senado Federal"}, "Colegiado": {"CodigoColegiado": "34", "SiglaColegiado": "CCJ", "NomeColegiado": "Comissão de Constituição, Justiça e Cidadania", "SiglaCasaColegiado": "SF", "NomeCasaColegiado": "Senado Federal"}, "TextosAssociados": {"TextoAssociado": [{"CodigoTexto": "10206075", "DescricaoTipoTexto": "Relatório Legislativo", "TipoDocumento": "PDF", "FormatoTexto": "application/pdf", "DataTexto": "2026-04-14", "UrlTexto": "http://legis.senado.leg.br/sdleg-getter/documento?dm=10206075", "DescricaoTexto": "Relatório Legislativo - SF264505014852", "AutoriaTexto": "Senador Weverton (PDT/MA)"}]}}, {"Data": "2026-04-12 08:51:06", "IdInformeLegislativo": "2281885", "Descricao": "Matéria constante da Pauta da 5ª Reunião da Comissão de Constituição, Justiça e Cidadania, agendada para o dia 15/04/2026.", "Local": {"CodigoLocal": "13565", "SiglaLocal": "SACCJ", "NomeLocal": "Secretaria de Apoio à Comissão de Constituição, Justiça e Cidadania", "SiglaCasaLocal": "SF", "NomeCasaLocal": "Senado Federal"}, "Colegiado": {"CodigoColegiado": "34", "SiglaColegiado": "CCJ", "NomeColegiado": "Comissão de Constituição, Justiça e Cidadania", "SiglaCasaColegiado": "SF", "No